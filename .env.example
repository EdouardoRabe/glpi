# Configuration GLPI API
# Copier ce fichier en `.env` et remplir les valeurs réelles

# URL de base du serveur GLPI
VITE_GLPI_BASE_URL=

# Endpoint pour obtenir le token (OAuth initSession)
VITE_GLPI_TOKEN_PATH=/api.php/v2.3/token

# Paramètres OAuth
VITE_GLPI_GRANT_TYPE=password
VITE_GLPI_CLIENT_ID=votre_client_id
VITE_GLPI_CLIENT_SECRET=votre_client_secret
VITE_GLPI_USERNAME=votre_username
VITE_GLPI_PASSWORD=votre_password
VITE_GLPI_SCOPE=

VITE_GLPI_APP_TOKEN=